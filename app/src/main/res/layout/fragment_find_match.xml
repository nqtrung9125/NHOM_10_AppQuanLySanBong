<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/appbar_height"
        android:background="@drawable/bg_appbar"
        android:clipToOutline="true">

        <ImageView android:layout_width="110dp" android:layout_height="110dp"
                android:layout_gravity="end|top" android:layout_marginEnd="-40dp" android:layout_marginTop="-45dp"
                android:importantForAccessibility="no" android:src="@drawable/ic_guest_deco_large" />

        <ImageView android:layout_width="56dp" android:layout_height="56dp"
                android:layout_gravity="end|top" android:layout_marginEnd="79dp" android:layout_marginTop="34dp"
                android:importantForAccessibility="no" android:src="@drawable/ic_guest_deco_small" />

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">
        
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Tìm trận"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium" />
        
                <TextView
                    android:id="@+id/tvCreateMatch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Tạo trận"
                    android:textColor="@color/lime"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingVertical="8dp" />
        
            </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <Button
                android:id="@+id/btnStaffMatch"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_ql_outline_small"
                android:textColor="@color/brand"
                android:text="Nhờ nhân viên cáp kèo"
                android:elevation="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:padding="4dp"
                android:background="@drawable/bg_pill"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabFindOpponent"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Bắt đối"
                    android:textSize="14sp"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/tabFindFriends"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:text="Tìm bạn chơi"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />

            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipNear"
                        style="@style/PillChip"
                        android:text="Gần tôi"
                        android:textColor="@android:color/white"
                        android:background="@drawable/bg_button_primary" android:drawableStart="@drawable/ic_kh_nav_match_on" android:drawablePadding="4dp" />

                    <TextView
                        android:id="@+id/chipToday"
                        style="@style/PillChip"
                        android:layout_marginStart="6dp"
                        android:text="Hôm nay" />

                    <TextView
                        android:id="@+id/chipBadminton"
                        style="@style/PillChip"
                        android:layout_marginStart="6dp"
                        android:text="Cầu lông" />

                    <TextView
                        android:id="@+id/chipPickleball"
                        style="@style/PillChip"
                        android:layout_marginStart="6dp"
                        android:text="Pickleball" />

                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_lt_notice_lavender"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/match_level_recommendation"
                        android:textColor="@color/brand_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/match_level_range"
                        android:textColor="@color/brand_mid"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnMatchSuggestions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_pill"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/match_suggestions_show"
                    android:textColor="@color/brand"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Gợi ý trận"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/llMatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav" />

</LinearLayout>
