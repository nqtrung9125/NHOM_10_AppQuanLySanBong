<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_header"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp" android:paddingEnd="20dp"
    android:paddingTop="16dp" android:paddingBottom="16dp">

    <TextView
        android:id="@+id/staffInitial"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:background="@drawable/bg_logo_circle"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/brand"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/staffName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/surface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/staffPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/brand_soft_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/staffRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pill"
        android:backgroundTint="@color/white_alpha_18"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingTop="4dp" android:paddingBottom="4dp"
        android:textColor="@color/surface"
        android:textSize="12sp" />
</LinearLayout>
