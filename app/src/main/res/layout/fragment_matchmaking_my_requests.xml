<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:tag="kh_light_status">

    <include android:id="@+id/appbar" layout="@layout/view_kh_compact_appbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/screen_padding" android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <LinearLayout style="@style/KhNoteSuccess">
                <TextView style="@style/KhNoteSuccessTitle" android:text="Yêu cầu đã gửi đến nhân viên" />
                <TextView style="@style/KhNoteSuccessBody" android:text="CK202611200003 · Bạn sẽ nhận thông báo khi có đối phù hợp." />
            </LinearLayout>

            <LinearLayout android:layout_marginTop="12dp" style="@style/KhCompactCard">
                <TextView style="@style/KhCardTitle" android:text="Đội Minh Anh · 5 người" />
                <TextView style="@style/KhCardStatus" android:text="Chờ nhân viên ghép đôi" />
                <TextView style="@style/KhCardMeta" android:text="Bóng đá 5 · 20/11 · 18:00 – 19:00" />
                <TextView style="@style/KhCardDetail" android:text="Trung bình · Tối đa 250.000đ/đội" />
            </LinearLayout>

            <LinearLayout android:layout_marginTop="12dp" style="@style/KhNoteInfo">
                <TextView style="@style/KhNoteInfoTitle" android:text="Các bước tiếp theo" />
                <TextView style="@style/KhNoteInfoBody" android:text="Nhận đề xuất → Hai bên đồng ý → Thanh toán đủ cọc → Xác nhận trận." />
            </LinearLayout>

            <TextView android:layout_marginTop="12dp" android:id="@+id/btn_view_received_proposal" style="@style/KhCompactSecondary" android:text="Xem đề xuất đã nhận" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding" android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">
        <TextView android:id="@+id/btn_find_match" style="@style/KhCompactPrimary" android:text="Về tìm trận" />
    </FrameLayout>

    <include android:id="@+id/bottomNav" layout="@layout/view_bottom_nav" />
</LinearLayout>
