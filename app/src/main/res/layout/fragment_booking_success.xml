<?xml version="1.0" encoding="utf-8"?>
<!-- KH-07 Thanh toán cọc thành công - Mã QR -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="kh_light_status"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_l">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_logo_circle"
            android:backgroundTint="@color/brand">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_kh_result_check" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/success_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/success_sub"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_label" />

        <!-- Vé -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <com.nhom10.appquanlysanbong.ui.widget.QrCodeView
                android:id="@+id/qrCode"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:contentDescription="@string/cd_qr" />

            <TextView
                android:id="@+id/tvBookingCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginTop="12dp" android:src="@drawable/ic_kh_qr_dash"  android:scaleType="centerInside" android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_status"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/brand_tint"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/status_deposit_paid"
                    android:textColor="@color/brand"
                    android:textSize="12sp" />
            </LinearLayout>

            <include
                android:id="@+id/rowCourt"
                layout="@layout/item_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s" />

            <include
                android:id="@+id/rowDate"
                layout="@layout/item_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s" />

            <include
                android:id="@+id/rowTime"
                layout="@layout/item_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s" />

            <include
                android:id="@+id/rowTotal"
                layout="@layout/item_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s" />

            <include
                android:id="@+id/rowDeposit"
                layout="@layout/item_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s" />

            <include
                android:id="@+id/rowRemain"
                layout="@layout/item_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s" />
        </LinearLayout>

        <include
            android:id="@+id/note"
            layout="@layout/view_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnViewBooking"
            style="@style/ButtonPrimary"
            android:layout_marginTop="14dp"
            android:text="@string/btn_view_booking" />

        <TextView
            android:id="@+id/tvHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/link_home"
            android:textColor="@color/brand"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>