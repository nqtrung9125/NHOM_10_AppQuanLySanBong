<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:tag="kh_light_status">

    <include android:id="@+id/appbar" layout="@layout/view_kh_compact_appbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/screen_padding" android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <LinearLayout style="@style/KhNoteSuccess">
                <TextView style="@style/KhNoteSuccessTitle" android:text="Hai đội đã thanh toán đủ cọc" />
                <TextView style="@style/KhNoteSuccessBody" android:text="Thông tin sân và giờ chơi đã được gửi cho hai đội." />
            </LinearLayout>

            <LinearLayout android:layout_marginTop="12dp" style="@style/KhCompactCard">
                <TextView style="@style/KhCardTitle" android:text="Minh Anh × Hoàng Nam" />
                <TextView style="@style/KhCardStatus" android:text="Bóng đá 5 người · Sân D1" />
                <TextView style="@style/KhCardMeta" android:text="20/11/2026 · 18:00 – 19:00" />
                <TextView style="@style/KhCardDetail" android:text="Mã đặt sân DS2026112000043" />
            </LinearLayout>

            <LinearLayout android:layout_marginTop="12dp" style="@style/KhCompactCard">
                <TextView style="@style/KhCardTitle" android:text="Phần đội bạn: 250.000đ" />
                <TextView style="@style/KhCardStatus" android:text="Đã thanh toán cọc: 75.000đ" />
                <TextView style="@style/KhCardMeta" android:text="Đội bạn còn trả tại sân: 175.000đ" />
                <TextView style="@style/KhCardDetail" android:text="Tổng cọc hai đội đã nhận: 150.000đ" />
            </LinearLayout>

            <LinearLayout android:layout_marginTop="12dp" style="@style/KhNoteInfo">
                <TextView style="@style/KhNoteInfoTitle" android:text="Nhân viên hỗ trợ" />
                <TextView style="@style/KhNoteInfoBody" android:text="Phan Ngọc Vinh · Xuất trình mã đặt sân khi đến. Nếu đổi lịch, cần xác nhận của cả hai đội." />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding" android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">
        <TextView android:id="@+id/btn_home" style="@style/KhCompactPrimary" android:text="Về trang chủ" />
    </FrameLayout>

    <include android:id="@+id/bottomNav" layout="@layout/view_bottom_nav" />
</LinearLayout>
