<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" android:minHeight="52dp"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="horizontal">
    <FrameLayout
        android:id="@+id/qlMenuIconBox"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_lt_account_icon">
        <ImageView
            android:id="@+id/qlMenuIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"

            android:scaleType="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/qlMenuLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="15sp"
        android:textColor="@color/text_primary"
        android:includeFontPadding="false" />

    <ImageView
        android:id="@+id/qlMenuChevron"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_lt_account_chevron"
        android:scaleType="center"
        android:importantForAccessibility="no" />
</LinearLayout>
