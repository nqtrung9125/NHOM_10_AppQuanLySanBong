<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <include
        android:id="@+id/appbar"
        layout="@layout/view_appbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" android:paddingHorizontal="@dimen/screen_padding" android:paddingTop="14dp" android:paddingBottom="12dp" android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Cảnh báo mưa lớn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_kh_rain_alert"
                android:gravity="center_vertical" android:padding="14dp">
                <ImageView android:layout_width="34dp" android:layout_height="34dp"
                    android:layout_marginEnd="10dp" android:importantForAccessibility="no"
                    android:scaleType="center" android:src="@drawable/ic_kh_reschedule_rain" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cảnh báo mưa lớn 17:00 – 19:00"
                    android:textColor="#DC2626"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                    <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Xác suất 80% · gió giật 8 m/s · mặt sân dễ trơn trượt"
                    android:textColor="#991B1B"
                    android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Lịch hiện tại -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lịch hiện tại · TS281001"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Sân A1 · Thứ Năm 15/10 · 17:00 – 19:00"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="#FEE2E2"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Mưa 80%"
                    android:textColor="#DC2626"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Gợi ý khung giờ thay thế -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Gợi ý khung giờ thay thế"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Option 1: Hôm nay -->
            <LinearLayout
                android:id="@+id/card_option1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:background="@drawable/bg_kh_card_choice"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <RadioButton
                    android:id="@+id/radio1" android:layout_width="20dp" android:layout_height="20dp"
                    android:checked="true"
                    android:clickable="false" android:button="@drawable/bg_kh_reschedule_radio" android:minWidth="0dp" android:minHeight="0dp" android:buttonTint="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Hôm nay · 19:30 – 21:30"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill"
                            android:backgroundTint="#E0E7FF"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="Tốt nhất"
                            android:textColor="@color/brand"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Mưa 20% · 26°C · Sân A1 còn trống"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Miễn phí · giữ nguyên cọc"
                        android:textColor="#16A34A"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Option 2: Ngày mai -->
            <LinearLayout
                android:id="@+id/card_option2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:background="@drawable/bg_kh_card_choice"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <RadioButton
                    android:id="@+id/radio2" android:layout_width="20dp" android:layout_height="20dp"
                    android:checked="false"
                    android:clickable="false" android:button="@drawable/bg_kh_reschedule_radio" android:minWidth="0dp" android:minHeight="0dp" android:buttonTint="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ngày mai 16/10 · 17:00 – 19:00"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="Phù hợp"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Nắng nhẹ · mưa 10% · 29°C"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Miễn phí · giữ nguyên cọc"
                        android:textColor="#16A34A"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Option 3: Thứ Bảy -->
            <LinearLayout
                android:id="@+id/card_option3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:background="@drawable/bg_kh_card_choice"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <RadioButton
                    android:id="@+id/radio3" android:layout_width="20dp" android:layout_height="20dp"
                    android:checked="false"
                    android:clickable="false" android:button="@drawable/bg_kh_reschedule_radio" android:minWidth="0dp" android:minHeight="0dp" android:buttonTint="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Thứ Bảy 17/10 · 17:00 – 19:00"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="Cuối tuần"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Nhiều mây · mưa 15% · 28°C"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Chênh +50.000đ"
                        android:textColor="#D97706"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Buttons -->
            <TextView
                android:id="@+id/btn_confirm_reschedule"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:text="Dời sang khung giờ đã chọn"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_keep_booking"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_outline"
                    android:gravity="center"
                    android:text="Giữ nguyên lịch"
                    android:textColor="@color/brand"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_cancel_booking"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_outline"
                    android:backgroundTint="#FEE2E2"
                    android:gravity="center"
                    android:text="Hủy &amp; hoàn cọc"
                    android:textColor="#DC2626"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
