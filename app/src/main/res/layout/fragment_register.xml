<?xml version="1.0" encoding="utf-8"?>
<!-- KH-03 Đăng ký -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include
        android:id="@+id/appbar"
        layout="@layout/view_appbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="20dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="20dp">

            <TextView
                style="@style/Text.Body.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/register_subtitle" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/label_full_name" />

            <EditText
                android:id="@+id/edtFullName"
                style="@style/InputCompact"
                android:layout_marginTop="4dp"
                android:autofillHints="name"
                android:hint="@string/hint_full_name"
                android:inputType="textPersonName" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/label_phone" />

            <EditText
                android:id="@+id/edtRegPhone"
                style="@style/InputCompact"
                android:layout_marginTop="4dp"
                android:autofillHints="phone"
                android:hint="@string/hint_phone"
                android:inputType="phone" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/label_email" />

            <EditText
                android:id="@+id/edtEmail"
                style="@style/InputCompact"
                android:layout_marginTop="4dp"
                android:autofillHints="emailAddress"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/label_cccd" />

            <EditText
                android:id="@+id/edtCccd"
                style="@style/InputCompact"
                android:layout_marginTop="4dp"
                android:hint="@string/hint_cccd"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="12" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/label_address" />

            <EditText
                android:id="@+id/edtAddress"
                style="@style/InputCompact"
                android:layout_marginTop="4dp"
                android:autofillHints="postalAddress"
                android:hint="@string/hint_address"
                android:inputType="textPostalAddress" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/label_password" />

            <EditText
                android:id="@+id/edtRegPassword"
                style="@style/InputCompact"
                android:layout_marginTop="4dp"
                android:autofillHints="newPassword"
                android:hint="@string/hint_password_min"
                android:inputType="textPassword" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/label_confirm_password" />

            <EditText
                android:id="@+id/edtConfirmPassword"
                style="@style/InputCompact"
                android:layout_marginTop="4dp"
                android:autofillHints="newPassword"
                android:hint="@string/hint_password"
                android:inputType="textPassword" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/label_level" />

            <LinearLayout
                android:id="@+id/levelContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal" />

            <!-- Liên kết VNeID -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="@color/brand_tint"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/vneid_title"
                        android:textColor="@color/brand_dark"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/vneid_sub"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnVneid"
                    android:layout_width="76dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_filter"
                    android:backgroundTint="@color/surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/vneid_action"
                    android:textColor="@color/brand"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRegister"
                style="@style/ButtonPrimary"
                android:layout_marginTop="8dp"
                android:text="@string/register" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>