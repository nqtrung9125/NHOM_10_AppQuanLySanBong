<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="12dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOutline"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_guest_outline"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/login_title"
            android:textAllCaps="false"
            android:textColor="@color/brand"
            android:textSize="@dimen/text_input" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPrimary"
            style="@style/ButtonPrimary"
            android:layout_width="0dp"
            android:layout_weight="1" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDemoAccounts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="?attr/selectableItemBackground"
        android:text="@string/guest_demo_accounts"
        android:textAllCaps="false"
        android:textColor="@color/brand" />
</LinearLayout>
