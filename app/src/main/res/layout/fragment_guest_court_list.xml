<?xml version="1.0" encoding="utf-8"?>
<!-- VL-01 Xem sân -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include
        android:id="@+id/appbar"
        layout="@layout/view_guest_appbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="@dimen/space_l"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_guest_banner"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_l"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/guest_banner_title"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_input"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:includeFontPadding="false"
                    android:text="@string/guest_banner_message"
                    android:textColor="@color/brand_soft_text"
                    android:textSize="@dimen/text_label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAll"
                    style="@style/FilterChip"
                    android:text="@string/filter_all" />

                <TextView
                    android:id="@+id/chipFootball"
                    style="@style/FilterChip"
                    android:layout_marginStart="@dimen/space_s"
                    android:text="@string/filter_football" />

                <TextView
                    android:id="@+id/chipBadminton"
                    style="@style/FilterChip"
                    android:layout_marginStart="@dimen/space_s"
                    android:text="@string/filter_badminton" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipPickleball"
                    style="@style/FilterChip"
                    android:text="@string/filter_pickleball" />

                <TextView
                    android:id="@+id/chipVolleyball"
                    style="@style/FilterChip"
                    android:layout_marginStart="@dimen/space_s"
                    android:text="@string/filter_volleyball" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardFootball"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_guest_info"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:minHeight="22sp"
                    android:text="@string/guest_football_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_button"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:minHeight="17sp"
                    android:text="@string/guest_football_schedule"
                    android:textColor="@color/brand"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:minHeight="18sp"
                    android:text="@string/guest_login_to_book"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:minHeight="20sp"
                    android:text="@string/guest_football_detail"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/guestSearch"
                style="@style/Input"
                android:layout_marginTop="12dp"
                android:hint="@string/guest_search_hint"
                android:inputType="text"
                android:imeOptions="actionDone" />

            <TextView
                android:id="@+id/guestEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/guest_empty"
                android:textColor="@color/text_muted"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llCourts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/actions"
        layout="@layout/view_guest_actions" />
</LinearLayout>
